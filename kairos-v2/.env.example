# Notion internal integration token (Settings → Connections → Develop or manage integrations).
# Share the "Membership Requests" database with this integration, or writes return 404.
NOTION_TOKEN=secret_xxx

# Membership Requests database ID (already filled in from your workspace).
NOTION_MEMBERSHIP_DATABASE_ID=01ff09d1f0d54728a907b9ed953e393c

# Set to "true" only locally, to let test submissions ("isTest": true) be
# validated without writing to Notion or setting off the zaps.
ALLOW_TEST_SUBMISSIONS=false

# Upstash Redis for a rate limit shared across all serverless instances.
# Easiest: Vercel → Storage/Marketplace → Upstash Redis → connect to this project,
# which sets KV_REST_API_URL / KV_REST_API_TOKEN automatically (also accepted).
# Leave empty to use the per-instance in-memory limit (fine for local dev).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- Automations (research, approve-to-send, daily digest) ----------
# Agent Pipeline database (default is the Kairos one; override only if it moves).
NOTION_PIPELINE_DATABASE_ID=86d266e140b74d43aa9783b874359bec

# Research (#1): Claude + live web search writes Options and Research Notes.
ANTHROPIC_API_KEY=
# RESEARCH_MODEL=claude-sonnet-5-5
# RESEARCH_DAILY_LIMIT=20

# Email via Resend (approve-to-send + digest). MAIL_FROM must be on a domain
# verified in Resend, e.g. "Kairos Concierge <concierge@yourdomain.com>".
RESEND_API_KEY=
MAIL_FROM=
# Where member replies go (an inbox you read). Optional BCC keeps you a copy.
MAIL_REPLY_TO=
# MAIL_BCC=
# MAIL_SUBJECT=Your Kairos request

# Daily digest (#4): who receives it, around 8am ET.
DIGEST_TO=

# Vercel sends this as "Authorization: Bearer ..." to the cron routes. Any long random string.
# It is also the key for the private /setup page: /setup?key=<CRON_SECRET>.
CRON_SECRET=

# Optional: Notion webhook signing secret. If unset, the app uses the
# verification token Notion sends during setup (stored once in Redis).
# NOTION_WEBHOOK_SECRET=
