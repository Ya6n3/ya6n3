# Notion internal integration token (Settings → Connections → Develop or manage integrations).
# Share the "Agent Pipeline" database with this integration, or writes return 404.
NOTION_TOKEN=secret_xxx

# Agent Pipeline database ID (already filled in from your workspace).
NOTION_PIPELINE_DATABASE_ID=86d266e140b74d43aa9783b874359bec

# Set to "true" only locally, to let test submissions be marked Source = Test.
ALLOW_TEST_SUBMISSIONS=false
