# Notion internal integration token (Settings → Connections → Develop or manage integrations).
# Share the "Membership Requests" database with this integration, or writes return 404.
NOTION_TOKEN=secret_xxx

# Membership Requests database ID (already filled in from your workspace).
NOTION_MEMBERSHIP_DATABASE_ID=01ff09d1f0d54728a907b9ed953e393c

# Set to "true" only locally, to let test submissions ("isTest": true) be
# validated without writing to Notion or setting off the zaps.
ALLOW_TEST_SUBMISSIONS=false
